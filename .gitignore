packages/
specs/*/readiness/generated-consumer-validation/nuget-packages/

# Feature 046 (US4, FR-011/012, D3): forward-looking evidence hygiene — ignore future
# regenerable readiness logs and zip archives only. Authored evidence (all *.md notes
# AND the fsi-session.txt transcript) stays tracked; no broad non-.md sweep, no removal
# of committed evidence, no history rewrite.
specs/*/readiness/logs/**
specs/*/readiness/**/readiness*.zip
# Feature 054 (US3, FR-007): pack-flow scratch (e.g. local-packages.md) is regenerable;
# scope the ignore to the `package/` subdir only so authored `.md` evidence elsewhere
# under readiness/ stays tracked.
specs/*/readiness/package/

# FSharp.Formatting (076): generated docs site is never committed (FR-012)
output/
.fsdocs/
tmp/

