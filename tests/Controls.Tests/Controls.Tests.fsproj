<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CatalogTests.fs" />
    <Compile Include="PublicSurfaceTests.fs" />
    <Compile Include="TypedControlContractTests.fs" />
    <Compile Include="TypedLoweringTests.fs" />
    <Compile Include="DiagnosticsTests.fs" />
    <Compile Include="ControlRuntimeContractTests.fs" />
    <Compile Include="DataGridTests.fs" />
    <Compile Include="SemanticTests.fs" />
    <Compile Include="InteractionTests.fs" />
    <Compile Include="TextInputTests.fs" />
    <Compile Include="AccessibilityTests.fs" />
    <Compile Include="RenderingTests.fs" />
    <Compile Include="ReconcileTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Controls\Controls.fsproj" />
    <!-- Feature 066 (US1/US2): the typed-catalog parity/drift/correspondence tests exercise
         the build-front single source `FS.Skia.UI.Build.CatalogGen` against the real
         `FS.Skia.UI.Controls.Typed` surface, so this suite references the governance engine. -->
    <ProjectReference Include="..\..\build\Governance\FS.Skia.UI.Build.fsproj" />
    <PackageReference Include="Expecto" />
    <!-- Feature 067: FsCheck (test-only, pinned 3.3.3 in Directory.Packages.props)
         drives the round-trip and determinism properties for the internal
         reconciler. Not a product dependency — DependencyReport is unaffected. -->
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
