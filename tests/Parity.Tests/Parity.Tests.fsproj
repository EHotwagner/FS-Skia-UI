<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Feature 048 (US1): deterministic scene-output encoder + byte-identical golden re-derivation.
         The old-vs-new `Parity`-helper report bridge (Tests.fs) retired in feature 052; this project
         is now the Scene-only deterministic scene-output oracle (the authoritative parity gate). -->
    <Compile Include="SceneOutput.fs" />
    <Compile Include="SceneOutputTests.fs" />
    <Compile Include="AnimationOutput.fs" />
    <Compile Include="AnimationOutputTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scene vocabulary for the scene-output oracle (SceneOutput.fs). No reference to the retiring
         Lib monolith: the `Parity` helper bridge it once exercised is gone (feature 052). -->
    <ProjectReference Include="..\..\src\Scene\Scene.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" />
  </ItemGroup>

</Project>
