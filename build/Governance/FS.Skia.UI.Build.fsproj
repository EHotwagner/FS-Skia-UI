<Project Sdk="Microsoft.NET.Sdk">

  <!-- Governance library (build-tooling, NOT a runtime/rendering package).
       Lives under build/ so runtime surface-baseline tooling does not sweep it.
       Published (043 / ADR D1, research R8) so generated `dotnet new fs-skia-ui`
       projects reference the in-process evidence engine instead of carrying the
       Python + run-audit.sh scripts. Inherits net10.0 / TreatWarningsAsErrors /
       FSharp.Core from Directory.Build.props and central package management. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.Skia.UI.Build</PackageId>
    <AssemblyName>FS.Skia.UI.Build</AssemblyName>
    <Version>0.1.114-preview.1</Version>
    <Title>FS.Skia.UI.Build</Title>
    <Description>Compiled-F# governance engine (evidence graph + merge-gate audit) consumed in-process by FS.Skia.UI build tooling and generated products.</Description>
    <PackageTags>fsharp;governance;evidence;build-tooling</PackageTags>
    <!-- Feature 054 (FR-009): every relocated-front-end FS3261 nullness site was resolved by
         safe null handling, so the project-local WarningsNotAsErrors escape hatch for FS3261
         is removed. Nullable=enable (from Directory.Build.props) plus the repo-wide
         TreatWarningsAsErrors now make any re-introduced FS3261 a build error for this project. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Spike.fsi" />
    <Compile Include="Spike.fs" />
    <!-- Feature 088 (US1, FR-003): Targets is the single source for the routable-gate
         projection AgentValidation.knownGates derives from, so it compiles before
         AgentValidation. Targets is self-contained (a closed DU + total functions). -->
    <Compile Include="Targets.fsi" />
    <Compile Include="Targets.fs" />
    <Compile Include="AgentValidation.fsi" />
    <Compile Include="AgentValidation.fs" />
    <Compile Include="SkillTreeGen.fsi" />
    <Compile Include="SkillTreeGen.fs" />
    <Compile Include="SkillSync.fsi" />
    <Compile Include="SkillSync.fs" />
    <Compile Include="Findings.fsi" />
    <Compile Include="Findings.fs" />
    <!-- Feature 058 (US1): pure skill-quality rubric check; depends only on Findings. -->
    <Compile Include="SkillQuality.fsi" />
    <Compile Include="SkillQuality.fs" />
    <!-- Feature 077 (FR-006): pure phase-hook parity guard; depends only on Findings. -->
    <Compile Include="PhaseHookParity.fsi" />
    <Compile Include="PhaseHookParity.fs" />
    <Compile Include="TargetMetadata.fsi" />
    <Compile Include="TargetMetadata.fs" />
    <Compile Include="Routing.fsi" />
    <Compile Include="Routing.fs" />
    <Compile Include="ContractView.fsi" />
    <Compile Include="ContractView.fs" />
    <Compile Include="PerPackageSurface.fsi" />
    <Compile Include="PerPackageSurface.fs" />
    <Compile Include="Capabilities.fsi" />
    <Compile Include="Capabilities.fs" />
    <!-- Feature 060: api-surface generator (FR-003) + the two anti-drift checks
         (SkillContractPathCheck FR-004, TemplateUpdateSkillPackageCheck FR-009). Pure
         modules over the capability catalog / packable set; reads + writes stay at the
         build interpreter edge (Front/Governance.fs). -->
    <Compile Include="ApiSurfaceGen.fsi" />
    <Compile Include="ApiSurfaceGen.fs" />
    <Compile Include="SkillContractPath.fsi" />
    <Compile Include="SkillContractPath.fs" />
    <Compile Include="TemplateUpdatePackage.fsi" />
    <Compile Include="TemplateUpdatePackage.fs" />
    <Compile Include="SkillistView.fsi" />
    <Compile Include="SkillistView.fs" />
    <Compile Include="ConstitutionFragments.fsi" />
    <Compile Include="ConstitutionFragments.fs" />
    <!-- Feature 057 (US1): canonical governed-block store + marker-splice render/currency
         generalizing the ConstitutionFragments splice to arbitrary keyed blocks. No .fsi
         (build front-end convention for new internal modules; plan §`.fsi` impact). -->
    <Compile Include="GovernedBlocks.fs" />
    <!-- Feature 066 (US1): typed single-source generator for the six 065 control catalog
         rows + the per-control marked-region splice/currency. Reuses the GovernedBlocks
         marker/splice precedent (so it compiles after it); pure, with IO at the
         Engine/Interpret.fs edge. Build-tooling .fsi (SkillTreeGen.fsi precedent). -->
    <Compile Include="CatalogGen.fsi" />
    <Compile Include="CatalogGen.fs" />
    <!-- Feature 069: the DTCG token parser/generator (single source ->
         src/Controls/DesignTokens.fs), mirroring CatalogGen. Pure; the only IO is at the
         Engine/Interpret.fs edge. Build-tooling .fsi (CatalogGen.fsi precedent). -->
    <Compile Include="DesignTokenGen.fsi" />
    <Compile Include="DesignTokenGen.fs" />
    <!-- Feature 083 (US1, FR-007/FR-008/FR-009): the ContrastCheck gate's validated-pairing
         set + pure evaluator. The WCAG arithmetic is single-sourced from the shipped
         FS.Skia.UI.Color package (ProjectReference below); the gate reads the alias-resolved
         DTCG facts (DesignTokenGen, compiled above) at the Engine/Interpret.fs edge. -->
    <Compile Include="ContrastGate.fsi" />
    <Compile Include="ContrastGate.fs" />
    <!-- Feature 078 (US1): single-source generator + currency check for the published
         "Controls" docs section. Reuses CatalogGen.catalogFacts + the keyed BEGIN/END
         GENERATED splice precedent (so it compiles after CatalogGen); pure, with IO at the
         interpreter edge. Build-tooling .fsi (CatalogGen.fsi precedent). -->
    <Compile Include="CatalogDocsGen.fsi" />
    <Compile Include="CatalogDocsGen.fs" />
    <!-- Feature 106 (US2, FR-007): the Controls documentation-coverage gate. Pure `.fsi`-text
         analysis; file reads + report write happen at the Engine/Interpret.fs edge
         (DesignTokenGen precedent). Build-tooling .fsi. -->
    <Compile Include="ControlsDocCoverage.fsi" />
    <Compile Include="ControlsDocCoverage.fs" />
    <Compile Include="Evidence/EvidenceFormatSchema.fsi" />
    <Compile Include="Evidence/EvidenceFormatSchema.fs" />
    <Compile Include="Evidence/TaskParser.fsi" />
    <Compile Include="Evidence/TaskParser.fs" />
    <Compile Include="Evidence/DepsParser.fsi" />
    <Compile Include="Evidence/DepsParser.fs" />
    <Compile Include="Evidence/SkillRegistry.fsi" />
    <Compile Include="Evidence/SkillRegistry.fs" />
    <Compile Include="Evidence/Graph.fsi" />
    <Compile Include="Evidence/Graph.fs" />
    <Compile Include="Evidence/StatusRegion.fsi" />
    <Compile Include="Evidence/StatusRegion.fs" />
    <Compile Include="Evidence/Scans.fsi" />
    <Compile Include="Evidence/Scans.fs" />
    <Compile Include="Evidence/DiffScan.fsi" />
    <Compile Include="Evidence/DiffScan.fs" />
    <Compile Include="Evidence/Audit.fsi" />
    <Compile Include="Evidence/Audit.fs" />
    <Compile Include="Evidence/Render.fsi" />
    <Compile Include="Evidence/Render.fs" />
    <Compile Include="Evidence/Engine.fsi" />
    <Compile Include="Evidence/Engine.fs" />
    <!-- Feature 064 (FR-004 / R1): the generated-product evidence façade the generated
         build.fsx reflection-invokes after resolving the engine from <FsSkiaUiVersion>. -->
    <Compile Include="Evidence/GeneratedRunner.fsi" />
    <Compile Include="Evidence/GeneratedRunner.fs" />
    <!-- Feature 062 (FR-006): single-source generator for docs/skillist-reference.md
         from the live SkillRegistry + Audit.ownsVocabulary (currency in TargetMetadataDrift). -->
    <Compile Include="SkillistReference.fsi" />
    <Compile Include="SkillistReference.fs" />
    <!-- Feature 062 (FR-008): mechanical cross-artifact symbol set-difference helper
         (diagnostics/guidance for speckit-analyze pass G, not a hard gate). -->
    <Compile Include="SymbolCrossCheck.fsi" />
    <Compile Include="SymbolCrossCheck.fs" />
    <!-- Feature 087 (US2, FR-003/004): static pinned-vs-local package-skew check over the
         captured per-package surface baselines (no network restore). Pure comparison +
         extraction; the file reads live at the Front/Governance.fs interpreter edge. -->
    <Compile Include="PackageSkew.fsi" />
    <Compile Include="PackageSkew.fs" />
    <!-- Feature 045: the build front-end relocated out of build.fsx into the compiled
         library. Helper modules first (BCL/regex only), then the value types, the MEL
         engine (Model/Update/Interpret), and the relocated heavy validators. -->
    <Compile Include="Front/BuildPaths.fs" />
    <!-- Feature 049: pure graphics-env classification + normalization; consumed by the
         spawn edge below and by Program startup. BCL-only; compiled before BuildProcess. -->
    <Compile Include="Front/BuildEnvironment.fs" />
    <Compile Include="Front/BuildProcess.fs" />
    <Compile Include="Front/BuildReports.fs" />
    <Compile Include="Front/BuildGeneratedScanning.fs" />
    <Compile Include="Front/BuildPackageResolution.fs" />
    <Compile Include="Front/BuildTemplateValidation.fs" />
    <Compile Include="Front/BuildProcessHealth.fs" />
    <Compile Include="Front/Support.fs" />
    <Compile Include="Preflight.fsi" />
    <Compile Include="Preflight.fs" />
    <Compile Include="Engine/Model.fsi" />
    <Compile Include="Engine/Model.fs" />
    <Compile Include="Publish.fsi" />
    <Compile Include="Publish.fs" />
    <Compile Include="PrePublish.fsi" />
    <Compile Include="PrePublish.fs" />
    <Compile Include="Front/Helpers.fs" />
    <Compile Include="Engine/Update.fsi" />
    <Compile Include="Engine/Update.fs" />
    <Compile Include="GeneratedProductContract.fsi" />
    <Compile Include="GeneratedProductContract.fs" />
    <Compile Include="GeneratedProduct.fsi" />
    <Compile Include="GeneratedProduct.fs" />
    <Compile Include="Guidance.fsi" />
    <Compile Include="Guidance.fs" />
    <Compile Include="Front/Governance.fs" />
    <Compile Include="Engine/Interpret.fsi" />
    <Compile Include="Engine/Interpret.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
    <!-- Feature 048: DiffPlex backs the additive PerPackageSurfaceDiff line comparison.
         Centrally pinned in Directory.Packages.props (no new PackageVersion); reuses the
         repository's existing golden-diff facility (plan §Dependency impact). -->
    <PackageReference Include="DiffPlex" />
  </ItemGroup>

  <!-- Feature 058 (US2, D3): consume the shipped SkillSupport helpers by
       ProjectReference (source, not the packed nupkg — no build-of-the-builder
       version circularity). Governance runs the same code the fsharp-* skills cite. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SkillSupport\SkillSupport.fsproj" />
    <!-- Feature 083 (FR-007): consume the shipped FS.Skia.UI.Color WCAG arithmetic by
         ProjectReference (source, not the packed nupkg — no build-of-the-builder version
         circularity), so the ContrastCheck gate measures through exactly the same
         Contrast.ratio / compositeOver the package ships. Color references only Scene. -->
    <ProjectReference Include="..\..\src\Color\Color.fsproj" />
  </ItemGroup>

</Project>
