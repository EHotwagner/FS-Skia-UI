<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tangle-and-compile examples project (feature 040). NOT shipped, NOT in the
       solution, NOT a runtime surface. Its sole purpose is to compile every
       ` ```fsharp ` block extracted from the six capability skills against the
       real pinned adopt-set packages, so a passing build IS the evidence that
       the cookbook snippets' API calls are correct (FR-014 / SC-007).

       The Generated/*.fs sources are derived artifacts: regenerated
       deterministically from the SKILL.md text by SkillExamplesCheck on every
       run. Never hand-edit them.

       Warning policy (research R2): cookbook snippets legitimately have unused
       bindings / non-exhaustive matches for brevity, so we DO NOT inherit the
       repo's TreatWarningsAsErrors promotions. The gate's bar is "does this API
       call compile against the real package", not lint cleanliness. Errors
       still fail the build. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
    <WarningLevel>0</WarningLevel>
    <NoWarn>$(NoWarn);FS0025;FS0026;FS0049;FS0052;FS0064;FS0078;FS1182;FS3370;FS0044</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated/*.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The report's minimal adopt set (versions pinned in
         Directory.Packages.props). FCS-free (FR-008). -->
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="FSharp.SystemTextJson" />
    <PackageReference Include="XParsec" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Fake.IO.FileSystem" />
    <PackageReference Include="Fake.Tools.Git" />
    <PackageReference Include="DiffPlex" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Expecto" />
    <PackageReference Include="Fake.Core.Target" />
  </ItemGroup>

</Project>
