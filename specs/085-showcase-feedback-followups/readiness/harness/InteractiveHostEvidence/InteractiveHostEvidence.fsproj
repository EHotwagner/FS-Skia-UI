<Project Sdk="Microsoft.NET.Sdk">

  <!-- Feature 085 T018 — tiny COMPILED self-closing harness for the durable interactive-host
       launch. A compiled exe (not fsi) is required for Silk.NET Vulkan window-surface creation.
       Deliberately outside FS-Skia-UI.sln so it does not affect governance test discovery. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Controls.Elmish\Controls.Elmish.fsproj" />
  </ItemGroup>

</Project>
