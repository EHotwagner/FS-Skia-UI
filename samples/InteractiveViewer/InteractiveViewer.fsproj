<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <FsSkiaUiPackageVersion Condition="'$(FsSkiaUiPackageVersion)' == ''">0.1.0-preview.1</FsSkiaUiPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedPackage)' != 'true'">
    <ProjectReference Include="..\..\src\Scene\Scene.fsproj" />
    <ProjectReference Include="..\..\src\SkiaViewer\SkiaViewer.fsproj" />
    <!-- Retains the monolith reference only for the residual rich KeyboardInput module this sample
         exercises (the input runtime has no split-package home until its own V3 stage). -->
    <ProjectReference Include="..\..\src\Lib\Lib.fsproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedPackage)' == 'true'">
    <PackageReference Include="FS.Skia.UI.Scene" Version="$(FsSkiaUiPackageVersion)" />
    <PackageReference Include="FS.Skia.UI.SkiaViewer" Version="$(FsSkiaUiPackageVersion)" />
    <PackageReference Include="FS.Skia.UI" Version="$(FsSkiaUiPackageVersion)" />
  </ItemGroup>

</Project>
