<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <FsSkiaUiPackageVersion Condition="'$(FsSkiaUiPackageVersion)' == ''">0.1.0-preview.1</FsSkiaUiPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedPackage)' != 'true'">
    <ProjectReference Include="..\..\src\Scene\Scene.fsproj" />
    <ProjectReference Include="..\..\src\SkiaViewer\SkiaViewer.fsproj" />
    <!-- The rich interactive input runtime now lives in its own split package, FS.Skia.UI.Input
         (downstream of SkiaViewer); the sample no longer references the retiring Lib monolith. -->
    <ProjectReference Include="..\..\src\Input\Input.fsproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePackedPackage)' == 'true'">
    <PackageReference Include="FS.Skia.UI.Scene" Version="$(FsSkiaUiPackageVersion)" />
    <PackageReference Include="FS.Skia.UI.SkiaViewer" Version="$(FsSkiaUiPackageVersion)" />
    <PackageReference Include="FS.Skia.UI.Input" Version="$(FsSkiaUiPackageVersion)" />
  </ItemGroup>

</Project>
