<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsPackable>true</IsPackable>
    <PackageId>FS.Skia.UI</PackageId>
    <AssemblyName>FS.Skia.UI</AssemblyName>
    <Version>0.1.5-preview.1</Version>
    <Title>FS.Skia.UI</Title>
    <Description>Elmish-only Vulkan desktop viewer primitives for F# and SkiaSharp.</Description>
    <PackageTags>fsharp;elmish;skia;vulkan;desktop</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fsi" />
    <Compile Include="Library.fs" />
    <Compile Include="KeyboardInput.fsi" />
    <Compile Include="KeyboardInput.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fable.Elmish" Version="4.2.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Vulkan.Extensions.KHR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing.Extensions" Version="2.23.0" />
    <PackageReference Include="SkiaSharp" Version="4.147.0-preview.2.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.147.0-preview.2.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.147.0-preview.2.1" />
    <PackageReference Include="YamlDotNet" Version="17.1.0" />
  </ItemGroup>

</Project>
